#!name=Google 搜索重定向
#!desc=将 Google 地区域名的首页和搜索入口重定向至 www.google.com。
#!author=Jarv1s0
#!homepage=https://github.com/Jarv1s0/Logic/blob/master/Loon/Docs/google-redirect.md
#!raw-url=https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/GoogleRedirect.lpx
#!tag=Google
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google_Search.png
#!loon_version=3.5.1(998)
#!date=2026-11-04 12:17:13

# 仅处理首页、/search 和 /webhp；不匹配账户、地图等其他路径或子域名。
# 目标不包含 www.google.com，避免本插件产生重定向循环。
[Rewrite]
request if ${url} ~= /^https?:\/\/(?:www\.)?(?:g\.cn|google\.(?:cn|com\.hk|co\.jp|co\.uk|fr|de|com\.tw|com\.sg|com\.au|co\.kr|co\.in|ca))((?:\/(?:search|webhp)?)?(?:\?[^#]*)?)$/ as google then redirect(302, "https://www.google.com${google.1}")

[MitM]
hostname = g.cn, www.g.cn, google.cn, www.google.cn, google.com.hk, www.google.com.hk, google.co.jp, www.google.co.jp, google.co.uk, www.google.co.uk, google.fr, www.google.fr, google.de, www.google.de, google.com.tw, www.google.com.tw, google.com.sg, www.google.com.sg, google.com.au, www.google.com.au, google.co.kr, www.google.co.kr, google.co.in, www.google.co.in, google.ca, www.google.ca
