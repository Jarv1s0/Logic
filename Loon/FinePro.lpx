# 上游脚本：https://github.com/curtinp118/Scripthub/blob/main/scripts/finepro/finepro.js
# 直接引用上游，脚本内容会随上游更新。

[Script]
response if ${url} ~= /^https?:\/\/api\.rc-backup\.com\/v1\/(subscribers\/[^\/]+|receipts)$/i then script("https://raw.githubusercontent.com/curtinp118/Scripthub/main/scripts/finepro/finepro.js") with requires_body=true, timeout=10, tag="Fine Pro"

[Mitm]
hostname = api.rc-backup.com
