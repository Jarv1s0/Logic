#!name = 高德地图净化
#!desc = 清理广告与推广，减少正常功能误删。缓存可能影响效果，默认不要求卸载重装；兼容性与验证边界见说明文档。
#!author = Jarv1s0
#!icon = https://raw.githubusercontent.com/Semporia/Hand-Painted-icon/master/Universal/Map.png
#!date = 2026-10-20 16:44:04

# 来源与修改说明：https://github.com/Jarv1s0/Logic/blob/master/Loon/Docs/amap.md

[Rewrite]
# 明确的广告或推广接口；路径必须完整匹配，避免误伤同名前缀接口。
^https:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen_rt(?:\?|$) reject-dict
^https:\/\/m5\.amap\.com\/ws\/info_bff\/rankingCard(?:\?|$) reject-dict
^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured(?:\?|$) reject-dict
^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/tips_adv(?:\?|$) reject-dict
^https:\/\/m5\.amap\.com\/ws\/aos\/activity\/bus\/sign\/task(?:\?|$) reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/boss\/transportation\/diversion\/resource\/driving(?:\?|$) reject-dict
^https:\/\/m5-zb\.amap\.com\/ws\/boss\/transportation\/diversion\/resource\/bus_only_refresh(?:\?|$) reject-dict

[Script]
# 按域名合并接口匹配，共用同一脚本；保留原有路径边界及响应处理。
http-response ^https:\/\/ai\.amap\.com\/v1\/ai_rec\/home_qs(?:\?|$) script-path = https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Amap/amap-new.js?v=20261020-4, requires-body = true, tag = 高德首页信息流净化
http-response ^https:\/\/m5\.amap\.com\/(?:ws\/faas\/amap-navigation\/main-page(?:\?|$)|ws\/shield\/dsp\/profile\/index\/nodefaasv3(?:\?|$)|ws\/faas\/amap-navigation\/main-page-assets(?:\?|$)|ws\/shield\/search_poi\/search\/sp(?:\?|$)|ws\/info_bff\/tradeUnionPortal(?:\?|$)|ws\/shield\/scene\/recommend(?:\?|$)|ws\/valueadded\/alimama\/splash_screen(?:\?|$)|ws\/faas\/amap-navigation\/main-page-aiqs(?:\?|$)) script-path = https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Amap/amap-new.js?v=20261020-4, requires-body = true, tag = 高德页面与广告净化
http-response ^https:\/\/m5-zb\.amap\.com\/(?:ws\/car-place\/show(?:\?|$)|ws\/boss\/car\/order\/content_info(?:\?|$)|ws\/promotion-web\/resource(?:\/home)?(?:\?|$)) script-path = https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Amap/amap-new.js?v=20261020-4, requires-body = true, tag = 高德打车与推广净化
http-response ^https:\/\/info\.amap\.com\/ws\/shield\/search\/poi\/detail(?:\?|$) script-path = https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Amap/amap-new.js?v=20261020-4, requires-body = true, tag = 高德地点详情净化

[MitM]
hostname = m5.amap.com,amap-aos-info-nogw.amap.com,m5-zb.amap.com,info.amap.com,ai.amap.com
