#!name = 高德地图净化
#!desc = 移除开屏广告、首页信息流推广、搜索广告、打车推广和地点详情推广。
#!author = Jarv1s0
#!icon = https://raw.githubusercontent.com/Semporia/Hand-Painted-icon/master/Universal/Map.png
#!date = 2026-11-04 12:17:13
#!loon_version=3.5.1(983)

# 来源与修改说明：https://github.com/Jarv1s0/Logic/blob/master/Loon/Docs/amap.md

[Rewrite]
# 明确的广告或推广接口；路径必须完整匹配，避免误伤同名前缀接口。
request if ${url} ~= /^https:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen_rt(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/info_bff\/rankingCard(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/tips_adv(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/aos\/activity\/bus\/sign\/task(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/transportation\/diversion\/resource\/driving(?:\?|$)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/transportation\/diversion\/resource\/bus_only_refresh(?:\?|$)/i then reject_dict(200)

[Script]
# 按域名合并接口匹配，共用同一脚本；保留原有路径边界及响应处理。
response if ${url} ~= /^https:\/\/ai\.amap\.com\/v1\/ai_rec\/home_qs(?:\?|$)/i then script("https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Amap/amap-new.js?v=20261021-1") with requires_body=true, tag="高德首页信息流净化"
response if ${url} ~= /^https:\/\/m5\.amap\.com\/(?:ws\/faas\/amap-navigation\/main-page(?:\?|$)|ws\/shield\/dsp\/profile\/index\/nodefaasv3(?:\?|$)|ws\/faas\/amap-navigation\/main-page-assets(?:\?|$)|ws\/shield\/search_poi\/search\/sp(?:\?|$)|ws\/info_bff\/tradeUnionPortal(?:\?|$)|ws\/shield\/scene\/recommend(?:\?|$)|ws\/valueadded\/alimama\/splash_screen(?:\?|$)|ws\/faas\/amap-navigation\/main-page-aiqs(?:\?|$))/i then script("https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Amap/amap-new.js?v=20261021-1") with requires_body=true, tag="高德页面与广告净化"
response if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/(?:ws\/boss\/car\/order\/content_info(?:\?|$)|ws\/promotion-web\/resource(?:\/home)?(?:\?|$))/i then script("https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Amap/amap-new.js?v=20261021-1") with requires_body=true, tag="高德打车与推广净化"
response if ${url} ~= /^https:\/\/info\.amap\.com\/ws\/shield\/search\/poi\/detail(?:\?|$)/i then script("https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Amap/amap-new.js?v=20261021-1") with requires_body=true, tag="高德地点详情净化"

[MitM]
hostname = m5.amap.com,amap-aos-info-nogw.amap.com,m5-zb.amap.com,info.amap.com,ai.amap.com
