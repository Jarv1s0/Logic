#!name = Spotify
#!desc = 移除音频广告、首页推广、搜索广告和播放页推广。
#!openUrl = https://loon-plugins.vercel.app
#!author = devchristian1337, Jarv1s0
#!tag = Spotify, AdBlock, Premium
#!loon_version = 3.5.1(983)
#!homepage = https://github.com/Jarv1s0/Logic/tree/master/Loon
#!icon = https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/App-Icons/spotify.png
#!date = 2026-11-04 12:17:13

# 上游来源：https://github.com/devchristian1337/loon-plugins/tree/7ae0a25b2de75746dc602bfa890b9737d3847a9f
# 六个脚本原样收录到本仓库；原 Spotify.Crack.Dev.js 保留，但不再被本插件调用。

[Argument]
spot-ev3-enable = switch,true,tag=Local config override,desc=使用预置配置覆盖 bootstrap/customize Protobuf（推荐）
spot-ev1-enable = switch,false,tag=Remote config modification,desc=按规则修改现有 Protobuf 配置；请勿与预置配置覆盖同时启用

[Rule]
AND,((DOMAIN-SUFFIX, spotify.com), (PROTOCOL, QUIC)),REJECT

DOMAIN,aet.spotify.com,REJECT

[Rewrite]
# 保留本仓库已确认的音频、赞助及 Adform 广告拦截规则。
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/ad-logic\/(?:prefetch|state\/config)(?:\?.*)?$/ then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/ads\/v2\/config(?:\?.*)?$/ then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/ads\/v3\/ads(?:\?.*)?$/ then reject(404)
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/sponsoredplaylist\/v1\/sponsored(?:\?.*)?$/ then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/podcast-ap4p\/leavebehinds\/ads(?:\?.*)?$/ then reject_dict(200)
request if ${url} ~= /^https:\/\/asia\.adform\.net(?::443)?\/(?:C|adfserve)\/.*$/ then reject(404)
# 保留本仓库的 iPad 艺人页布局规则。
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?(\/artistview\/v1\/artist\/.*[?&]platform=)iphone((?:&.*)?$)/ as artist then url.replace("https://spclient.wg.spotify.com${artist.1}ipad${artist.2}")
request if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize/i then request.header.del("if-none-match")
request if ${url} ~= /^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon/i then reject_dict(200)

# Hide the discovery feed on the Now Playing screen (personal preference)
request if ${url} ~= /^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/watch-feed-entrypoints\/v.\/discovery-from-seed/i then reject_dict(200)

# Hide the membership info in Settings (display only, can be removed)
request if ${url} ~= /^https:\/\/.*-spclient\.spotify\.com(:443)?\/pam-view-service\//i then reject_dict(200)

# Block the AI DJ URL
request if ${url} ~= /37i9dQZF1EYkqdzj48dyYq/i then reject_dict(200)

[Mitm]
hostname = spclient.wg.spotify.com, *spclient.spotify.com, asia.adform.net

[Script]
request if ${url} ~= /^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service/i then script("https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Spotify/spot-gabo.js") with timeout=10, tag="Spotify gabo"

response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse/i then script("https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Spotify/spot-NoSearchAd.js") with requires_body=true, binary_body_mode=true, timeout=10, tag="Spotify search ads"
response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/casita\/v.\/home\//i then script("https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Spotify/spot-NoHomeAd.js") with requires_body=true, binary_body_mode=true, timeout=10, tag="Spotify home ads"
response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify/i then script("https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Spotify/spot-NoScrollAd.js") with requires_body=true, binary_body_mode=true, timeout=10, tag="Spotify scroll ads"
response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$/i then script("https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Spotify/spot-proto-eevee.js") with requires_body=true, binary_body_mode=true, timeout=10, tag="Spotify protobuf (remote)", enable=${spot-ev1-enable}
response if ${url} ~= /^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$/i then script("https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Spotify/spot-proto-ev3.js") with requires_body=true, binary_body_mode=true, timeout=10, tag="Spotify protobuf (local)", enable=${spot-ev3-enable}
