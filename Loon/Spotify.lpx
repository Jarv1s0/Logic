#!name = Spotify
#!desc = 移除 Spotify 广告并启用部分 Premium 功能；不支持极高音质。两套 Protobuf 脚本只能启用一套；启用插件后请重新登录以应用完整配置。
#!openUrl = https://loon-plugins.vercel.app
#!author = devchristian1337, Jarv1s0
#!tag = Spotify, AdBlock, Premium
#!loon_version = 3.5.1(978)
#!homepage = https://github.com/Jarv1s0/Logic/tree/master/Loon
#!icon = https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/App-Icons/spotify.png
#!date = 2026-10-09

# 上游来源：https://github.com/devchristian1337/loon-plugins/tree/7ae0a25b2de75746dc602bfa890b9737d3847a9f
# 六个脚本原样收录到本仓库；原 Spotify.Crack.Dev.js 保留，但不再被本插件调用。

[Argument]
spot-ev3-enable = switch,true,false,tag=Local config override,desc=使用预置配置覆盖 bootstrap/customize Protobuf（推荐）
spot-ev1-enable = switch,false,true,tag=Remote config modification,desc=按规则修改现有 Protobuf 配置；请勿与预置配置覆盖同时启用

[Rule]
AND,((DOMAIN-SUFFIX, spotify.com), (PROTOCOL, QUIC)),REJECT

DOMAIN,aet.spotify.com,REJECT

[Rewrite]
# 保留本仓库已确认的音频、赞助及 Adform 广告拦截规则。
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/ad-logic\/(?:prefetch|state\/config)(?:\?.*)?$/ then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/ads\/v2\/config(?:\?.*)?$/ then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/ads\/v3\/ads(?:\?.*)?$/ then reject(404)
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/sponsoredplaylist\/v1\/sponsored(?:\?.*)?$/ then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/podcast-ap4p\/leavebehinds\/ads(?:\?.*)?$/ then reject_dict(200)
request if ${url} ~= /^https:\/\/asia\.adform\.net(?::443)?\/(?:C|adfserve)\/.*$/ then reject(404)
# 保留本仓库的 iPad 艺人页布局规则。
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?(\/artistview\/v1\/artist\/.*[?&]platform=)iphone((?:&.*)?$)/ as artist then url.replace("https://spclient.wg.spotify.com${artist.1}ipad${artist.2}")
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize header-del if-none-match
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon reject-dict

# Hide the discovery feed on the Now Playing screen (personal preference)
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/watch-feed-entrypoints\/v.\/discovery-from-seed reject-dict

# Hide the membership info in Settings (display only, can be removed)
^https:\/\/.*-spclient\.spotify\.com(:443)?\/pam-view-service\/ reject-dict

# Block the AI DJ URL
37i9dQZF1EYkqdzj48dyYq reject-dict

[Mitm]
hostname = spclient.wg.spotify.com, *spclient.spotify.com, asia.adform.net

[Script]
http-request ^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service script-path=https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Spotify/spot-gabo.js, timeout=10, tag=Spotify gabo

http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse script-path=https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Spotify/spot-NoSearchAd.js, requires-body=true, binary-body-mode=true, timeout=10, tag=Spotify search ads
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/casita\/v.\/home\/ script-path=https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Spotify/spot-NoHomeAd.js, requires-body=true, binary-body-mode=true, timeout=10, tag=Spotify home ads
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify script-path=https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Spotify/spot-NoScrollAd.js, requires-body=true, binary-body-mode=true, timeout=10, tag=Spotify scroll ads
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$ script-path=https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Spotify/spot-proto-eevee.js, requires-body=true, binary-body-mode=true, timeout=10, tag=Spotify protobuf (remote), enable={spot-ev1-enable}
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$ script-path=https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Spotify/spot-proto-ev3.js, requires-body=true, binary-body-mode=true, timeout=10, tag=Spotify protobuf (local), enable={spot-ev3-enable}
