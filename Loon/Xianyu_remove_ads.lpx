#!name=闲鱼广告净化
#!desc=移除开屏广告、广告视频、首页推广、搜索推荐、本地信息流广告、详情广告和我的页面推荐商品流。
#!author=Jarv1s0
#!icon=https://raw.githubusercontent.com/lige47/lige_icon/main/icon/03CNSoft/xianyu.png
#!homepage=https://github.com/Jarv1s0/Logic/blob/master/Loon/Docs/xianyu.md
#!loon_version=3.5.1(998)
#!date=2026-11-04 12:17:13
#!tag=去广告,闲鱼

# 开屏接口参考 ddgksf2013，来源及验证边界见说明文档。
[Rewrite]
# 开屏接口：仅匹配独立 splash.ads API 和数字版本，不匹配相似前缀。
response if ${url} ~= /^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop(?:\.[a-z0-9_]+)*\.splash\.ads\/\d+(?:\.\d+)*(?:\/)?(?:\?|$)/ then response.body.mock("text", "", 200)
# 开屏曝光接口；拦截曝光本身不代表跳过开屏。
response if ${url} ~= /^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\.expose\/\d+(?:\.\d+)*(?:\/)?(?:\?|$)/ then response.body.mock("text", "", 200)
# HAR 确认的广告视频目录；保留同一 CDN 的其他视频路径。
response if ${url} ~= /^https:\/\/video-(?:zb|sh)\.cloudvideocdn\.taobao\.com\/mama_searchad_algo_upload\// then response.body.mock("text", "", 200)
# HAR 中反复出现的跟踪像素；不代表能移除广告卡片。
response if ${url} ~= /^https:\/\/df\.tanx\.com\/spf3(?:\?|$)/ then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/(?:mtop\.taobao\.idlehome\.home\.(?:nextfresh|circle\.list)|mtop\.taobao\.idlemtopsearch\.(?:search(?:\.(?:shade|discover))?|item\.search\.activate)|mtop\.taobao\.idle\.(?:item\.(?:recommend(?:\.list)?|buy\.feeds)|user\.strategy\.list|local\.home)|mtop\.idle\.user\.page\.my\.adapter)\/\d+(?:\.\d+)*\/?(?:\?|$)/i then script("https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Xianyu/xianyu.js?v=20261104-3") with requires_body=true, timeout=10, tag="闲鱼页面广告过滤"

[MitM]
hostname = acs.m.goofish.com, g-acs.m.goofish.com, video-zb.cloudvideocdn.taobao.com, video-sh.cloudvideocdn.taobao.com, df.tanx.com
