#!name=闲鱼开屏广告拦截
#!desc=拦截开屏广告接口及已确认的广告视频路径。需启用 MitM 并信任证书；未验证真机效果，缓存广告和倒计时可能仍存在。
#!author=Jarv1s0
#!homepage=https://github.com/Jarv1s0/Logic/blob/master/Loon/Docs/xianyu.md
#!loon_version=3.5.1(998)
#!date=2026-11-04
#!tag=去广告,闲鱼

# 开屏接口参考 ddgksf2013，来源及验证边界见说明文档。
[Rewrite]
# 开屏接口：仅匹配独立 splash.ads API 和数字版本，不匹配相似前缀。
response if ${url} ~= /^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop(?:\.[a-z0-9_]+)*\.splash\.ads\/\d+(?:\.\d+)*(?:\/)?(?:\?|$)/ then response.body.mock("text", "", 200)
# 开屏曝光接口；拦截曝光本身不代表跳过开屏。
response if ${url} ~= /^https:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.idle\.ad\.expose\/\d+(?:\.\d+)*(?:\/)?(?:\?|$)/ then response.body.mock("text", "", 200)
# HAR 确认的广告视频目录；保留同一 CDN 的其他视频路径。
response if ${url} ~= /^https:\/\/video-zb\.cloudvideocdn\.taobao\.com\/mama_searchad_algo_upload\// then response.body.mock("text", "", 200)

[MitM]
hostname = acs.m.goofish.com, g-acs.m.goofish.com, video-zb.cloudvideocdn.taobao.com
