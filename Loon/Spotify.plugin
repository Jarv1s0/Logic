#!name=Spotify去广告（增强版）
#!desc=基于 001ProMax 版本修复，首次启用后请重新登录 Spotify。
#!author=app2smile, 001ProMax, Jarv1s0
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://github.com/Jarv1s0/Logic/tree/master/Loon
#!icon=https://github.com/Koolson/Qure/blob/master/IconSet/Color/Spotify.png
#!date=2026-07-29 00:00:00

[Rewrite]
# 屏蔽 Pendragon 推广内容。
^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/pendragon\/ reject-dict

# 使用 iPad 歌手页布局，恢复歌手列表展示。
^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/artistview\/v1\/artist\/(.*)&platform=iphone header https://spclient.wg.spotify.com/artistview/v1/artist/$1&platform=ipad

# 强制 Spotify 返回完整 Protobuf 正文，避免 304 空响应绕过脚本。
^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$ header-del if-none-match

[Script]
# 固定到本仓库中已经审查的脚本 commit，避免后续更新静默改变执行代码。
http-response ^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$ script-path=https://raw.githubusercontent.com/Jarv1s0/Logic/d9345e5b3bb647bc328b4be5e914f02b48368981/Loon/Script/Spotify.Crack.Dev.js, requires-body=true, binary-body-mode=true, timeout=5, tag=Spotify-Protobuf

[MitM]
hostname= *-spclient.spotify.com, spclient.wg.spotify.com
