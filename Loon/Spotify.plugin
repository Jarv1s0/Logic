#!name=Spotify去广告（增强版）
#!desc=基于 001ProMax 版本修复，首次启用后请重新登录 Spotify。
#!author=app2smile, 001ProMax, Jarv1s0
#!tag=去广告
#!loon_version=3.5.1(978)
#!homepage=https://github.com/Jarv1s0/Logic/tree/master/Loon
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Spotify.png
#!date=2026-08-05 00:00:00

[Argument]
tab=switch, true, tag=移除 Premium 入口, desc=控制是否隐藏底栏 Premium 按钮和侧边栏套餐入口
useractivity=switch, true, tag=启用 Apple 设备接力, desc=控制是否允许通过 UserActivity 在 Apple 设备之间接力

[Rewrite]
# 屏蔽 Pendragon 推广内容。
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/pendragon\// then reject_dict(200)

# 使用 iPad 歌手页布局，恢复歌手列表展示。
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?(\/artistview\/v1\/artist\/.*[?&]platform=)iphone((?:&.*)?$)/ as artist then url.replace("https://spclient.wg.spotify.com${artist.1}ipad${artist.2}")

# 拦截音频广告及其伴随展示广告的请求。
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/ad-logic\/(?:prefetch|state\/config)(?:\?.*)?$/ then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/ads\/v2\/config(?:\?.*)?$/ then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/ads\/v3\/ads(?:\?.*)?$/ then reject(404)
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/sponsoredplaylist\/v1\/sponsored(?:\?.*)?$/ then reject_dict(200)
request if ${url} ~= /^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/podcast-ap4p\/leavebehinds\/ads(?:\?.*)?$/ then reject_dict(200)

# 拦截 HAR 中确认的 Adform 首页广告投放与跳转请求。
request if ${url} ~= /^https:\/\/asia\.adform\.net(?::443)?\/(?:C|adfserve)\/.*$/ then reject(404)

[Script]
# 固定到本仓库中已经审查的脚本 commit，避免后续更新静默改变执行代码。
# 仅复用同脚本版本和同开关参数下已修改的配置，其余情况强制获取完整响应。
http-request ^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$ script-path=https://raw.githubusercontent.com/Jarv1s0/Logic/a2601d0380bff33d09a10cc7574561483c726467/Loon/Script/Spotify.Crack.Dev.js, timeout=5, argument=[{tab},{useractivity}], tag=Spotify-Config-Cache
http-response ^https:\/\/(?:[a-z0-9]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize|browsita\/v1\/browse)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Jarv1s0/Logic/a2601d0380bff33d09a10cc7574561483c726467/Loon/Script/Spotify.Crack.Dev.js, requires-body=true, binary-body-mode=true, timeout=5, argument=[{tab},{useractivity}], tag=Spotify-Protobuf

[MitM]
hostname= *-spclient.spotify.com, spclient.wg.spotify.com, asia.adform.net
