# 本地适配于 2026-11-02：转换为 Loon 分节语法，修正协议和域名匹配边界。

[Rewrite]
^https:\/\/oss\.umetrip\.com\/fs\/advert\/polite reject-404
^https?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native reject-404

# 会员权益图片及会员推广素材
^https:\/\/oss\.umetrip\.com\/fs\/(equityCenter\/static|membership\/rights)\/ reject-404

[Script]
http-response ^https?:\/\/(114\.115\.217\.129|umerp\.umetrip\.com|home\.umetrip\.com|umehome\.umetrip\.com|sns\.umetrip\.com|opactivity\.umetrip\.com|activity\.umetrip\.com)\/gateway\/api\/umetrip\/native(?:\?[^#]*)?$ script-path=https://raw.githubusercontent.com/Jarv1s0/Logic/master/Loon/Script/Umetrip/umetrip_ads.js?v=20261102-9, requires-body=true, binary-body-mode=true, timeout=60, tag=航旅纵横

[MITM]
hostname = umerp.umetrip.com, home.umetrip.com, umehome.umetrip.com, sns.umetrip.com, opactivity.umetrip.com, activity.umetrip.com, discardrp.umetrip.com, startup.umetrip.com, oss.umetrip.com
